[language-server.markdown-oxide]
command = "markdown-oxide"

{{ if eq .profile "home" -}}
# ~/bin/drawio-ls: `space a` on a link to a *.drawio.svg creates/opens it in draw.io.
[language-server.drawio-ls]
command = "drawio-ls"
{{ end -}}

[language-server.rust-analyzer.config]
diagnostics = { disabled = ["unlinked-file"] }
check.command = "clippy"
cargo.features = "all"

# Resolve imports of PEP 723 scripts from their inline deps.
[language-server.ty]
environment = { TY_UV = "scripts" }

[language-server.ty.config]
diagnosticMode = "workspace"

[[language]]
name = "markdown"
language-servers = ["markdown-oxide"{{ if eq .profile "home" }}, "drawio-ls"{{ end }}]
roots = [".moxide.toml"]

[[language]]
name = "rust"

[[language]]
name = "python"
language-servers = ["ty", "ruff"]
