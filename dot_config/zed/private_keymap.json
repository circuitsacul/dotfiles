[
  {
    "bindings": {
      "ctrl-alt-f": "workspace::FocusCenterPane"
    }
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu && !BufferSearchBar",
    "bindings": {
      "space": null,
      "n": "vim::WrappingLeft",
      "e": ["vim::Down", { "display_lines": true }],
      "i": ["vim::Up", { "display_lines": true }],
      "o": "vim::WrappingRight",

      "k": "vim::NextWordEnd",
      "shift-k": ["vim::NextWordEnd", { "ignore_punctuation": true }],

      "j": "vim::HelixSelectNext",
      "shift-j": "vim::HelixSelectPrevious",

      "l": "vim::InsertLineBelow",
      "shift-l": "vim::InsertLineAbove",

      "shift-e": "vim::JoinLines",
      "alt-shift-e": "vim::JoinLines",

      "shift-i": null,
      "alt-shift-i": null,

      "shift-n": "pane::ActivatePreviousItem",
      "shift-o": "pane::ActivateNextItem",

      "g shift-g": "vim::EndOfDocument",
      "g n": "vim::StartOfLine",
      "g o": "vim::EndOfLine",
      "g e": "vim::Down",
      "g i": "vim::Up",

      "space w n": "workspace::ActivatePaneLeft",
      "space w e": "workspace::ActivatePaneDown",
      "space w i": "workspace::ActivatePaneUp",
      "space w o": "workspace::ActivatePaneRight",
      "space d": "diagnostics::DeployCurrentFile",
      "space shift-d": "diagnostics::Deploy",
      "space p": "editor::ShowEditPrediction",

      "ctrl-w n": "workspace::ActivatePaneLeft",
      "ctrl-w e": "workspace::ActivatePaneDown",
      "ctrl-w i": "workspace::ActivatePaneUp",
      "ctrl-w o": "workspace::ActivatePaneRight",

      "z e": "vim::LineDown",
      "z i": "vim::LineUp",
      "z n": "search::SelectNextMatch",
      "z shift-n": "search::SelectPreviousMatch",

      "shift-z e": [
        "action::Sequence",
        ["vim::LineDown", ["workspace::SendKeystrokes", "shift-z"]]
      ],
      "shift-z i": [
        "action::Sequence",
        ["vim::LineUp", ["workspace::SendKeystrokes", "shift-z"]]
      ],
      "shift-z n": [
        "action::Sequence",
        ["search::SelectNextMatch", ["workspace::SendKeystrokes", "shift-z"]]
      ],
      "shift-z shift-n": [
        "action::Sequence",
        [
          "search::SelectPreviousMatch",
          ["workspace::SendKeystrokes", "shift-z"]
        ]
      ]
    }
  },
  {
    "context": "VimControl && vim_mode == helix_normal && !menu && !BufferSearchBar",
    "bindings": {
      "h": "vim::HelixInsert",
      "shift-h": "vim::InsertFirstNonWhitespace"
    }
  },
  {
    "context": "vim_mode == helix_select && !menu && !BufferSearchBar",
    "bindings": {
      "h": "vim::InsertBefore",
      "shift-h": "vim::InsertFirstNonWhitespace"
    }
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "alt-x": "vim::NormalBefore"
    }
  },
  {
    "context": "(Workspace && !Editor && !Terminal && !menu) || ((vim_mode == helix_normal || vim_mode == helix_select) && !menu && !BufferSearchBar) || (AcpThread && !Editor && !Terminal && !menu) || (ThreadsSidebar && not_searching) || (ProjectPanel && not_editing) || (GitPanel && ChangesList && !GitBranchSelector) || (OutlinePanel && not_editing)",
    "bindings": {
      "space a": "agent::Toggle",
      "space shift-a": "agent::ToggleFocus",
      "space e": "project_panel::Toggle",
      "space shift-e": "project_panel::ToggleFocus",
      "space o": [
        "action::Sequence",
        ["outline_panel::ToggleFocus", ["workspace::SendKeystrokes", "escape"]]
      ],
      "space t": [
        "action::Sequence",
        [
          "multi_workspace::FocusWorkspaceSidebar",
          ["workspace::SendKeystrokes", "escape"]
        ]
      ],
      "space shift-t": [
        "action::Sequence",
        [
          "multi_workspace::FocusWorkspaceSidebar",
          ["workspace::SendKeystrokes", "escape"]
        ]
      ],
      "space l": "git_panel::Toggle",
      "space shift-l": "git_panel::ToggleFocus",
      "space n": "agent::NewThread",
      "space s p": ["projects::OpenRecent", { "create_new_window": false }],
      "space s w": "git::Worktree",
      "space s b": "git::Branch"
    }
  },
  {
    "context": "AcpThread > Editor",
    "bindings": {
      "enter": "editor::Newline",
      "ctrl-enter": "agent::Chat"
    }
  },
  {
    "context": "(AcpThread && !Editor && !Terminal && !menu) || (AgentPanel && !Editor && !Terminal && !menu)",
    "bindings": {
      "q": "agent::Toggle"
    }
  },
  {
    "context": "AcpThread > Editor && (vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "bindings": {
      "q": "agent::Toggle"
    }
  },
  {
    "context": "ThreadsSidebar && not_searching",
    "bindings": {
      "space": null,
      "space t": "multi_workspace::CloseWorkspaceSidebar",
      "space shift-t": "multi_workspace::FocusWorkspaceSidebar",
      "space n": "agents_sidebar::NewThreadInGroup",
      "q": "multi_workspace::CloseWorkspaceSidebar",

      "n": "menu::SelectParent",
      "e": "editor::MoveDown",
      "i": "editor::MoveUp",
      "o": "menu::SelectChild",
      "shift-e": "multi_workspace::NextProject",
      "shift-i": "multi_workspace::PreviousProject",
      "enter": [
        "action::Sequence",
        ["menu::Confirm", "multi_workspace::CloseWorkspaceSidebar"]
      ],
      "shift-enter": "menu::Confirm",
      "/": "agents_sidebar::FocusSidebarFilter"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "space": null,
      "space space": "project_panel::Open",
      "q": "project_panel::Toggle",
      "enter": [
        "action::Sequence",
        ["project_panel::Open", "project_panel::Toggle"]
      ],
      "shift-enter": "project_panel::Open",

      "n": "project_panel::CollapseSelectedEntry",
      "e": "menu::SelectNext",
      "i": "menu::SelectPrevious",
      "o": "project_panel::ExpandSelectedEntry",
      "shift-e": "menu::SelectNext",
      "shift-i": "menu::SelectPrevious",

      "/": "file_finder::Toggle",
      "?": "project_panel::NewSearchInDirectory",

      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "r": "project_panel::Rename",

      "d": "project_panel::Trash",
      "shift-d": "project_panel::Delete"
    }
  },
  {
    "context": "GitPanel && ChangesList && !GitBranchSelector",
    "bindings": {
      "space": null,
      "shift-space": null,
      "space l": "git_panel::Close",
      "q": "git_panel::Close",

      "x": "git::ToggleStaged",
      "shift-x": "git::StageAll",
      "g x": "git::StageRange",

      "n": "git_panel::CollapseSelectedEntry",
      "e": "git_panel::NextEntry",
      "i": "git_panel::PreviousEntry",
      "o": "git_panel::ExpandSelectedEntry"
    }
  },
  {
    "context": "GitPanel && menu",
    "bindings": {
      "q": "menu::Cancel"
    }
  },
  {
    "context": "OutlinePanel && not_editing",
    "bindings": {
      "space": null,
      "space space": "outline_panel::OpenSelectedEntry",
      "q": "workspace::ToggleRightDock",
      "enter": [
        "action::Sequence",
        ["outline_panel::OpenSelectedEntry", "workspace::ToggleRightDock"]
      ],
      "shift-enter": "outline_panel::OpenSelectedEntry",
      "n": "outline_panel::CollapseSelectedEntry",
      "e": "menu::SelectNext",
      "i": "menu::SelectPrevious",
      "o": "outline_panel::ExpandSelectedEntry"
    }
  }
]
