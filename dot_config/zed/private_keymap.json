[
  {
    "context": "Workspace && !Editor && !Terminal && !menu",
    "bindings": {
      "space a": "agent::Toggle",
      "space shift-a": "agent::ToggleFocus",
      "space e": "project_panel::Toggle",
      "space shift-e": "project_panel::ToggleFocus",
      "space t": "multi_workspace::ToggleWorkspaceSidebar",
      "space shift-t": "multi_workspace::FocusWorkspaceSidebar",
      "space l": "git_panel::Toggle",
      "space shift-l": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu && !BufferSearchBar",
    "bindings": {
      "space": null,
      "n": "vim::WrappingLeft",
      "e": ["vim::Down", { "display_lines": true }],
      "i": ["vim::Up", { "display_lines": true }],
      "o": "vim::WrappingRight",

      "k": "vim::NextWordEnd",
      "shift-k": ["vim::NextWordEnd", { "ignore_punctuation": true }],

      "j": "vim::HelixSelectNext",
      "shift-j": "vim::HelixSelectPrevious",

      "l": "vim::InsertLineBelow",
      "shift-l": "vim::InsertLineAbove",

      "shift-e": "vim::JoinLines",
      "alt-shift-e": "vim::JoinLines",

      "shift-i": null,
      "alt-shift-i": null,

      "shift-n": "pane::ActivatePreviousItem",
      "shift-o": "pane::ActivateNextItem",

      "g shift-g": "vim::EndOfDocument",
      "g n": "vim::StartOfLine",
      "g o": "vim::EndOfLine",
      "g e": "vim::Down",
      "g i": "vim::Up",

      "space w n": "workspace::ActivatePaneLeft",
      "space w e": "workspace::ActivatePaneDown",
      "space w i": "workspace::ActivatePaneUp",
      "space w o": "workspace::ActivatePaneRight",
      "space d": "diagnostics::DeployCurrentFile",
      "space shift-d": "diagnostics::Deploy",
      "space a": "agent::Toggle",
      "space shift-a": "agent::ToggleFocus",
      "space e": "project_panel::Toggle",
      "space shift-e": "project_panel::ToggleFocus",
      "space p": "editor::ShowEditPrediction",
      "space t": "multi_workspace::ToggleWorkspaceSidebar",
      "space shift-t": "multi_workspace::FocusWorkspaceSidebar",
      "space l": "git_panel::Toggle",
      "space shift-l": "git_panel::ToggleFocus",

      "ctrl-w n": "workspace::ActivatePaneLeft",
      "ctrl-w e": "workspace::ActivatePaneDown",
      "ctrl-w i": "workspace::ActivatePaneUp",
      "ctrl-w o": "workspace::ActivatePaneRight",

      "z e": "vim::LineDown",
      "z i": "vim::LineUp",
      "shift-z e": "vim::LineDown",
      "shift-z i": "vim::LineUp"
    }
  },
  {
    "context": "VimControl && vim_mode == helix_normal && !menu && !BufferSearchBar",
    "bindings": {
      "h": "vim::HelixInsert",
      "shift-h": "vim::InsertFirstNonWhitespace"
    }
  },
  {
    "context": "vim_mode == helix_select && !menu && !BufferSearchBar",
    "bindings": {
      "h": "vim::InsertBefore",
      "shift-h": "vim::InsertFirstNonWhitespace"
    }
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "alt-x": "vim::NormalBefore"
    }
  },
  {
    "context": "ThreadsSidebar && not_searching",
    "bindings": {
      "n": "menu::SelectParent",
      "e": "menu::SelectNext",
      "i": "menu::SelectPrevious",
      "o": "menu::SelectChild",
      "shift-e": "multi_workspace::NextProject",
      "shift-i": "multi_workspace::PreviousProject",
      "enter": "menu::Confirm",
      "/": "agents_sidebar::FocusSidebarFilter"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "space": null,
      "space e": "workspace::CloseActiveDock",
      "space shift-e": "project_panel::ToggleFocus",
      "space space": "project_panel::Open",

      "n": "project_panel::CollapseSelectedEntry",
      "e": "menu::SelectNext",
      "i": "menu::SelectPrevious",
      "o": "project_panel::ExpandSelectedEntry"
    }
  },
  {
    "context": "GitPanel && ChangesList && !GitBranchSelector",
    "bindings": {
      "space": null,
      "shift-space": null,
      "space l": "workspace::CloseActiveDock",
      "space shift-l": "git_panel::ToggleFocus",

      "x": "git::ToggleStaged",
      "shift-x": "git::StageAll",
      "g x": "git::StageRange",

      "n": "git_panel::CollapseSelectedEntry",
      "e": "git_panel::NextEntry",
      "i": "git_panel::PreviousEntry",
      "o": "git_panel::ExpandSelectedEntry"
    }
  }
]
