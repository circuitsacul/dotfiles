// Zellij v0.46.0's built-in catppuccin-mocha theme with the bright green highlights removed:
// https://github.com/zellij-org/zellij/blob/v0.46.0/zellij-utils/assets/themes/catppuccin-mocha.kdl
// A full definition is needed: omitted components use Zellij defaults, not the base theme.
//
// Differences from the built-in theme (everything else is identical, terminal_colors included):
// - Green -> Blue for the focused frame, the mode indicator / emphasis_2 and table titles.
//   Green stays only where it means something: exit_code_success, player_6, terminal_colors.
// - Ribbons (tabs) are flat text on the bar background instead of green / white blocks:
//   Text when selected, Overlay0 otherwise, a Surface0 block on mouse hover.
// - Backgrounds use Base (the Catppuccin terminal background) instead of Mantle.
//
// text_unselected is also the Zellij terminal window's default foreground and background, so
// keep it at Text on Base; dimming it to restyle the bar greys out all terminal text there.
themes {
    catppuccin-mocha-custom {
        text_unselected {
            base 205 214 244
            background 30 30 46
            emphasis_0 250 179 135
            emphasis_1 137 220 235
            emphasis_2 137 180 250
            emphasis_3 245 194 231
        }
        text_selected {
            base 205 214 244
            background 88 91 112
            emphasis_0 255 202 171
            emphasis_1 142 225 240
            emphasis_2 137 180 250
            emphasis_3 248 197 234
        }
        ribbon_selected {
            base 205 214 244
            background 30 30 46
            emphasis_0 243 139 168
            emphasis_1 250 179 135
            emphasis_2 245 194 231
            emphasis_3 137 180 250
        }
        ribbon_unselected {
            base 108 112 134
            background 30 30 46
            emphasis_0 243 139 168
            emphasis_1 147 153 178
            emphasis_2 137 180 250
            emphasis_3 245 194 231
        }
        ribbon_hover {
            base 205 214 244
            background 49 50 68
            emphasis_0 243 139 168
            emphasis_1 147 153 178
            emphasis_2 137 180 250
            emphasis_3 245 194 231
        }
        table_title {
            base 137 180 250
            background 30 30 46
            emphasis_0 250 179 135
            emphasis_1 137 220 235
            emphasis_2 137 180 250
            emphasis_3 245 194 231
        }
        table_cell_selected {
            base 205 214 244
            background 88 91 112
            emphasis_0 255 202 171
            emphasis_1 142 225 240
            emphasis_2 137 180 250
            emphasis_3 248 197 234
        }
        table_cell_unselected {
            base 205 214 244
            background 30 30 46
            emphasis_0 250 179 135
            emphasis_1 137 220 235
            emphasis_2 137 180 250
            emphasis_3 245 194 231
        }
        list_selected {
            base 205 214 244
            background 88 91 112
            emphasis_0 255 202 171
            emphasis_1 142 225 240
            emphasis_2 137 180 250
            emphasis_3 248 197 234
        }
        list_unselected {
            base 205 214 244
            background 30 30 46
            emphasis_0 250 179 135
            emphasis_1 137 220 235
            emphasis_2 137 180 250
            emphasis_3 245 194 231
        }
        frame_selected {
            base 137 180 250
            background 0
            emphasis_0 250 179 135
            emphasis_1 137 220 235
            emphasis_2 245 194 231
            emphasis_3 245 194 231
        }
        frame_highlight {
            base 250 179 135
            background 0
            emphasis_0 245 194 231
            emphasis_1 250 179 135
            emphasis_2 250 179 135
            emphasis_3 250 179 135
        }
        exit_code_success {
            base 166 227 161
            background 0
            emphasis_0 137 220 235
            emphasis_1 24 24 37
            emphasis_2 245 194 231
            emphasis_3 137 180 250
        }
        exit_code_error {
            base 243 139 168
            background 0
            emphasis_0 249 226 175
            emphasis_1 250 179 135
            emphasis_2 245 194 231
            emphasis_3 137 220 235
        }
        multiplayer_user_colors {
            player_1 245 194 231
            player_2 137 180 250
            player_3 250 179 135
            player_4 249 226 175
            player_5 137 220 235
            player_6 166 227 161
            player_7 243 139 168
            player_8 185 203 255
            player_9 230 202 125
            player_10 255 182 187
        }
        // terminal_colors: https://github.com/catppuccin/alacritty/blob/main/catppuccin-mocha.toml
        terminal_colors {
            black 69 71 90
            red 243 139 168
            green 166 227 161
            yellow 249 226 175
            blue 137 180 250
            magenta 245 194 231
            cyan 148 226 213
            white 186 194 222
            bright_black 88 91 112
            bright_red 243 139 168
            bright_green 166 227 161
            bright_yellow 249 226 175
            bright_blue 137 180 250
            bright_magenta 245 194 231
            bright_cyan 148 226 213
            bright_white 166 173 200
        }
    }
}
