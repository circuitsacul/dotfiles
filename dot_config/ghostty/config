# mouse-scroll-multiplier = precision:0.1,discrete:1
mouse-scroll-multiplier = discrete:1
mouse-shift-capture = never
# mouse-reporting = true
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,no-notify
notify-on-command-finish-after = 5s
# scrollback-limit = 10000000

# window-padding-balance = true
# window-padding-color = extend
# window-decoration = auto
window-subtitle = working-directory

# `detect`
shell-integration = zsh

keybind=super+n=previous_tab
keybind=super+o=next_tab
keybind=global:super+enter=toggle_quick_terminal
keybind=super+t=new_tab

theme=Catppuccin Mocha
window-theme=ghostty

window-padding-x=0
window-padding-y=0

# gtk-titlebar-style=tabs
gtk-titlebar=true

# `flat` -> flat with terminal window
# `raised` -> shadow over terminal area
# `raised-border` -> subtle border
gtk-toolbar-style = flat

gtk-wide-tabs = false

# `native` -> tabs & decirations on different lines
# `tabs` -> merged line with tabs & decorations
gtk-titlebar-style = native

# 'top', 'bottom', 'hidden'
gtk-tabs-location = top

# 'auto' (default), 'always', 'never'
window-show-tab-bar = always

# `system` -> system notification
# `audio` -> play custom sound
# `attention` (default) -> request att when unfocused; not really sure what this does on KDE
# `title` (defulat) -> bell emoji in title
# `border` -> border around alerted surface
bell-features = no-system,no-audio,attention,title,no-border
