[diff]
	tool = difftastic
[difftool]
	prompt = false
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"
[pager]
	pager = "delta"
	difftool = true
[alias]
	dft = difftool
	dlog = "!f() { GIT_EXTERNAL_DIFF=difft git log -p --ext-diff $@; }; f"
	wtr = "!f() { \
		set -euo pipefail; \
		name=$1; \
		dir=$(printf '%s' \"$name\" | sed -e 's/%/%25/g' -e 's|/|%2F|g'); \
		git worktree remove \"$dir\" ; \
	}; f"

	wt = "!f() { \
		: git switch; \
		set -euo pipefail; \
		name=${1:?missing branch name}; \
		dir=$(printf '%s' \"$name\" | sed -e 's/%/%25/g' -e 's|/|%2F|g'); \
		mkdir -p -- .worktrees; \
		[ -f .worktrees/.gitignore ] || printf '*\n' > .worktrees/.gitignore; \
		if [ ! -d \".worktrees/$dir\" ]; then \
			if git show-ref --verify --quiet -- \"refs/heads/$name\"; then \
				git worktree add \".worktrees/$dir\" \"$name\"; \
			else \
				git worktree add -b \"$name\" \".worktrees/$dir\"; \
			fi; \
		fi; \
		cd -- \".worktrees/$dir\" && exec \"${SHELL:-bash}\"; \
	}; f"

[commit]
	gpgsign = true
[user]
	email = me@circuitsacul.dev
	name = circuitsacul
[init]
	defaultBranch = master
