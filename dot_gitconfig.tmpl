[diff]
	tool = difftastic
[difftool]
	prompt = false
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"
[pager]
	pager = "delta"
	difftool = true
[alias]
	dft = difftool
	dlog = "!f() { GIT_EXTERNAL_DIFF=difft git log -p --ext-diff $@; }; f"
	wtl = worktree list
	wtr = "!f() { exec git-wt remove \"$@\"; }; f"

	wt = "!f() { exec git-wt create \"$@\"; }; f"

[commit]
	gpgsign = {{ .git.gpgsign }}
[user]
	email = {{ .git.email | quote }}
	name = {{ .git.name | quote }}
[init]
	defaultBranch = {{ .git.defaultBranch | quote }}
