#!/usr/bin/env bash

sess=""

while getopts "s:a" opt; do
  case "$opt" in
    s) sess="$OPTARG" ;;
    a) sess=$(tr -dc '[:alnum:]' </dev/urandom | head -c 8) ;;
    *) echo "usage: $0 [-s NAME] [-a] [PATH]" >&2; exit 1 ;;
  esac
done

shift $((OPTIND - 1))

proj=$(realpath "${1:-.}")
[[ -z "$sess" ]] && sess=$(z-session-name "$proj")

if ! tmux has-session -t="$sess" 2>/dev/null; then
  tmux new-session -s "$sess" -n tree -d -c "$proj" yazi
  tmux set-option -t "$sess" @project_root "$proj"
  tmux select-window -t "$sess:tree"
fi

destroy_unattached=off
if [[ -n "${ZELLIJ:-}" ]]; then
  destroy_unattached=on
fi

tmux attach-session -t "=$sess" \; \
  set-option -t "=$sess:" destroy-unattached "$destroy_unattached"
