#!/usr/bin/env bash
# Open the notebook's yhx session (see usage below).
set -euo pipefail

# Override in chezmoi.toml:
#   [data.notebook]
#   moxide = "..."  # markdown-oxide vault (holds .moxide.toml)
#   root = "..."    # yhx session root (default: moxide)
{{- $moxide := dig "notebook" "moxide" (joinPath .chezmoi.homeDir "notebook/moxide") . }}
{{- $root := dig "notebook" "root" $moxide . }}
moxide={{ $moxide | replace "'" "'\\''" | printf "'%s'" }}
root={{ $root | replace "'" "'\\''" | printf "'%s'" }}

usage() {
  cat >&2 <<EOF
Usage: note                 Attach to the notebook's yhx session at its root
       note daily [DATE...]  Also open a daily note (default: today's) in it;
                             DATE as accepted by \`markdown-oxide daily\`, e.g. yesterday, +1
EOF
  exit 2
}

case "${1-}" in
  "") exec yhx "$root" ;;
  daily) shift ;;
  *) usage ;;
esac

# markdown-oxide resolves (and creates) the note and hands its path to $EDITOR; echo captures it.
# Using a yhx-launching EDITOR instead would leak it into a tmux server started by yhx.
note=$(cd -- "$moxide" && EDITOR=echo markdown-oxide daily "$@")
exec yhx "$root" -- edit "$note"
