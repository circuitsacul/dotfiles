#!/usr/bin/env bash
set -euo pipefail

layout="z"
name=""
auto_name=false
fresh=false

usage() {
    cat <<EOF
Usage: zj [-s NAME] [-a] [-n] [-l LAYOUT]
  -s NAME    Use NAME as the session name (default: derived from CWD path)
  -a         Auto: create an unnamed session (let zellij pick a name)
  -n         New: don't resurrect an existing session with the same name
  -l LAYOUT  Layout to use when creating (default: z)
  -c         Use the compact layout
  -h         Show this help
EOF
}

while getopts ":s:ancl:h" opt; do
    case "$opt" in
        s) name="$OPTARG" ;;
        a) auto_name=true ;;
        n) fresh=true ;;
        c) layout="compact" ;;
        l) layout="$OPTARG" ;;
        h) usage; exit 0 ;;
        \?) echo "Unknown option: -$OPTARG" >&2; usage >&2; exit 2 ;;
        :)  echo "Option -$OPTARG requires an argument" >&2; usage >&2; exit 2 ;;
    esac
done

$auto_name && exec zellij --layout "$layout"

[[ -z "$name" ]] && name=$(z-session-name "$(pwd -P)")

$fresh && zellij delete-session "$name" >/dev/null 2>&1 || true
exec zellij attach --create "$name" options --default-layout "$layout"
